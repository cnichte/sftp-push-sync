{
  "name": "sftp-push-sync-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for sftp-push-sync: core sync engine, CLI and Electron GUI",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/check-syntax.mjs && npm run test:types",
    "test": "node --test packages/core/test/*.test.mjs packages/cli/test/*.test.mjs && npm run test:types",
    "test:types": "tsc --noEmit --strict --types node --module NodeNext --moduleResolution NodeNext --target ES2022 packages/core/test/types.mts",
    "dev": "npm run dev -w @sftp-push-sync/gui",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "release:mac": "npm run dist:mac-arm -w @sftp-push-sync/gui",
    "release:mac-intel": "npm run dist:mac-intel -w @sftp-push-sync/gui",
    "release:stage:linux": "node scripts/stage-release.mjs --platform=linux",
    "release:win": "npm run dist:win -w @sftp-push-sync/gui",
    "release:tag": "node scripts/release-tag.mjs",
    "release:tag:dry": "node scripts/release-tag.mjs --dry-run",
    "release:patch": "node scripts/release-version.mjs --type patch",
    "release:minor": "node scripts/release-version.mjs --type minor",
    "release:major": "node scripts/release-version.mjs --type major",
    "publish:npm": "npm publish ./packages/core --access public && npm publish ./packages/cli --access public",
    "ncu-me": "ncu -i --format group",
    "tree": "tree -a -L 4 ./packages > directory-structure.txt"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "ssh2": "1.17.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "hugo",
    "sftp",
    "deploy",
    "sync"
  ],
  "author": "Carsten Nichte",
  "license": "GPL-3.0-or-later"
}
