{
  "name": "@sftp-push-sync/gui",
  "version": "4.1.0",
  "description": "VeloSync desktop application for sftp-push-sync",
  "type": "module",
  "private": true,
  "main": "electron/main.mjs",
  "author": "Carsten Nichte",
  "homepage": "https://carsten-nichte.de",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k -n renderer,electron \"npm:dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "npm run build:renderer && electron-builder",
    "dist:mac-arm": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "@gfazioli/mantine-window": "^3.2.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@sftp-push-sync/core": "^4.1.0",
    "@tabler/icons-react": "^3.19.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.3.9",
    "i18next": "^23.15.1",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.0.2",
    "sftp-push-sync": "*",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "de.carsten-nichte.sftp-push-sync",
    "productName": "VeloSync",
    "electronVersion": "32.3.3",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "VeloSync benötigt Zugriff auf das lokale Netzwerk, um SFTP-Server zu erreichen."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://carsten-nichte.de/releases/velosync-app/"
    }
  }
}
